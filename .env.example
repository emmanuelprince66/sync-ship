# Base URL the browser calls. In dev, keep "/api/v1/" so the Vite proxy forwards to VITE_API_PROXY_TARGET (no CORS).
# In production, set the full API URL, e.g. https://api.sync360.africa/api/v1/
VITE_API_BASE_URL=/api/v1/
VITE_API_PROXY_TARGET=https://staging-api.sync360.africa

# "api" = real login/signup/OTP against the backend. "mock" = skip the backend and sign in with a demo account.
VITE_AUTH_MODE=api
